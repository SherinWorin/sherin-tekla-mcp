<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The MCP server (stdio). Two builds:
      net48  - Windows + Tekla Structures 2025 (the real one; x64).
      net8.0 - mock backend only, for CI and for trying the tools without Tekla.
    On non-Windows machines only net8.0 is built.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SherinTeklaMcp.Server</RootNamespace>
    <AssemblyName>SherinTeklaMcp.Server</AssemblyName>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net48;net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net8.0</TargetFrameworks>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <PlatformTarget>x64</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official MCP C# SDK (netstandard2.0 + net8.0, so it also runs on .NET Framework 4.8). -->
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\SherinTeklaMcp.Tekla\SherinTeklaMcp.Tekla.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SherinTeklaMcp.Core\SherinTeklaMcp.Core.csproj" />
  </ItemGroup>

  <!-- Ship settings and rule files next to the exe (config\settings.json, config\rules\*.json). -->
  <ItemGroup>
    <None Include="..\..\config\**\*" Link="config\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
