<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Live Tekla Structures 2025 backend. Windows only, .NET Framework 4.8, x64.

    Compiles against the official Tekla 2025 NuGet packages (2025.0.0) but does NOT copy the
    Tekla DLLs to the output (ExcludeAssets="runtime"). At run time TeklaAssemblyResolver loads
    the DLLs of YOUR installed Tekla 2025 from its 'bin' folder. That matters: Tekla 2024+ names
    its remoting channel after the DLL file version, so the NuGet copies (2025.0.0.0) cannot talk
    to an installed 2025.0.xxxxx Tekla - the installed DLLs can.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>SherinTeklaMcp.Tekla</RootNamespace>
    <TeklaVersion Condition="'$(TeklaVersion)' == ''">2025.0.0</TeklaVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SherinTeklaMcp.Core\SherinTeklaMcp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tekla.Structures" Version="$(TeklaVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Tekla.Structures.Model" Version="$(TeklaVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Tekla.Structures.Catalogs" Version="$(TeklaVersion)" ExcludeAssets="runtime" />
    <!-- Lets the net48 project build without the .NET Framework 4.8 Developer Pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
