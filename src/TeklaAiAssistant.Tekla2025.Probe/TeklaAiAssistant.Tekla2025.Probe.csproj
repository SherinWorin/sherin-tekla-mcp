<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Required by TSAppConfigPatcherTask for every Visual Studio/MSBuild build. -->
    <TeklaVersion>2025.0</TeklaVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TeklaAiAssistant.Core/TeklaAiAssistant.Core.csproj" />
    <ProjectReference Include="../TeklaAiAssistant.Commands/TeklaAiAssistant.Commands.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="System.Windows.Forms" />
    <PackageReference Include="Tekla.Structures.Model" Version="2025.0.0" />
    <PackageReference Include="TSAppConfigPatcherTask" Version="2.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../extensions/**/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="extensions" />
    <Content Include="../../config/stadium-concept.json" CopyToOutputDirectory="PreserveNewest" LinkBase="config" />
  </ItemGroup>
  <Target Name="StageReadSelectionCommand" AfterTargets="Build">
    <Copy SourceFiles="../TeklaAiAssistant.Commands/bin/$(Configuration)/net48/TeklaAiAssistant.Commands.dll"
          DestinationFolder="$(TargetDir)extensions/TeklaAiAssistant.Sample.extension/Model.tab/Inspection.panel/ReadSelection.pushbutton" />
  </Target>
</Project>
